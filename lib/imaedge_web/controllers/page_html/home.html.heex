<Layouts.marketing_shell flash={@flash}>
  <section class="py-[clamp(56px,9vw,120px)] pb-[clamp(48px,6vw,80px)] max-md:py-[40px] max-md:pb-[32px] relative">
    <div class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3 grid grid-cols-[1.05fr_0.95fr] gap-[clamp(32px,5vw,80px)] items-center max-[980px]:grid-cols-1 max-[980px]:gap-12">
      <div>
        <h1 class="font-brand-sans font-black text-[clamp(56px,9vw,132px)] max-md:text-[48px] max-[460px]:text-[40px] leading-[0.92] tracking-[-0.045em] text-ink brand-reveal opacity-0 translate-y-2.5 motion-safe:animate-rise">
          Images. <span class="block text-brand-accent-d italic font-black">Together.</span>
          <span class="block text-mid font-medium tracking-[-0.035em]">At the Edge.</span>
        </h1>
        <p class="text-[clamp(17px,1.6vw,21px)] max-md:text-[16px] leading-[1.45] text-ink-2 max-w-[38ch] mt-7 max-md:mt-5 tracking-[-0.01em] brand-reveal opacity-0 translate-y-2.5 motion-safe:animate-rise">
          You both take photos. You want to blog the day before bed. But at night the day is split across two phones, and merging and sifting through them is the worst part of the trip. imaedge is one link both phones can dump their originals into, fix the timestamps on, and review side by side.
        </p>
        <div class="mt-9 max-md:mt-6 flex items-center gap-5 flex-wrap brand-reveal opacity-0 translate-y-2.5 motion-safe:animate-rise">
          <form
            action={~p"/collections"}
            method="post"
            class="inline-flex"
            data-collection-name-form
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="name" value="" />
            <button
              type="submit"
              class="group inline-flex items-center gap-2.5 px-6 py-4 max-md:px-5 max-md:py-3 bg-ink text-paper rounded-[4px] font-medium text-[16px] max-md:text-[15px] tracking-[-0.01em] transition-colors hover:bg-[#1a1a1a] cursor-pointer"
            >
              <span>Start a collection</span>
              <svg
                class="w-[18px] h-[18px] stroke-current stroke-[1.8] fill-none transition-transform group-hover:translate-x-[3px]"
                viewBox="0 0 24 24"
              >
                <path
                  d="M5 12h14M13 5l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </form>
          <a
            class="group inline-flex items-center gap-2 py-4 text-ink font-medium text-[15px] tracking-[-0.005em]"
            href="#how"
          >
            See how it works
          </a>
        </div>
      </div>

      <div
        class="relative w-full max-w-[560px] max-[980px]:mx-auto flex flex-col gap-5 brand-reveal opacity-0 translate-y-2.5 motion-safe:animate-rise"
        aria-hidden="true"
      >
        <div class="relative bg-white border border-black/[0.10] rounded-[10px] py-2.5 px-3 flex items-center gap-3 shadow-[0_1px_2px_rgba(10,10,10,0.04),0_12px_24px_-12px_rgba(10,10,10,0.10)]">
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-[#fb7474]"></span>
            <span class="w-2 h-2 rounded-full bg-[#f7c057]"></span>
            <span class="w-2 h-2 rounded-full bg-[#5cc174]"></span>
          </span>
          <span class="flex-1 font-brand-mono text-[12.5px] text-ink-2 truncate">
            <span class="text-mid">imaedge.app/i/</span><span class="text-ink">tidal-harbor-gate-0b7x4pn2ra</span>
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-tint rounded-[3px] font-brand-sans text-[11px] text-mid">
            <svg class="w-3 h-3 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
              <path d="M9 9h10v10H9zM5 5h10v10" />
            </svg>
            copy
          </span>
        </div>

        <div class="flex items-center gap-2 text-[12.5px] font-brand-mono text-mid flex-wrap">
          <span>shared between</span>
          <span class="inline-flex items-center px-2 py-1 bg-ink/[0.78] rounded-[3px] font-brand-mono text-[10.5px] text-white tracking-[0.01em]">
            quiet-otter
          </span>
          <span class="opacity-40">+</span>
          <span class="inline-flex items-center px-2 py-1 bg-brand-accent/[0.92] rounded-[3px] font-brand-mono text-[10.5px] text-ink tracking-[0.01em]">
            golden-fox
          </span>
        </div>

        <div class="relative aspect-[4/5] w-full max-[980px]:aspect-[5/4]">
          <div
            class="absolute top-0 left-0 w-[58%] aspect-[4/5] rounded-[14px] overflow-hidden bg-tint z-[3] transition-transform duration-[600ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] shadow-[0_1px_2px_rgba(10,10,10,0.04),0_20px_40px_-16px_rgba(10,10,10,0.22),0_40px_80px_-24px_rgba(10,10,10,0.18)]"
            style="transform: rotate(-3.5deg);"
          >
            <picture class="block w-full h-full">
              <source
                type="image/avif"
                srcset={"#{~p"/images/home/whale-4x5-360.avif"} 360w, #{~p"/images/home/whale-4x5-720.avif"} 720w"}
                sizes="(max-width: 980px) 58vw, 325px"
              />
              <source
                type="image/webp"
                srcset={"#{~p"/images/home/whale-4x5-360.webp"} 360w, #{~p"/images/home/whale-4x5-720.webp"} 720w"}
                sizes="(max-width: 980px) 58vw, 325px"
              />
              <img
                class="w-full h-full object-cover"
                src={~p"/images/home/whale-4x5-720.webp"}
                width="720"
                height="900"
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <span class="absolute left-2.5 top-2.5 inline-flex items-center gap-1.5 px-2 py-1 bg-ink/[0.78] backdrop-blur-md rounded-[3px] font-brand-mono text-[10.5px] text-white tracking-[0.01em]">
              quiet-otter
            </span>
          </div>
          <div
            class="absolute top-[14%] right-0 w-[52%] aspect-[4/5] rounded-[14px] overflow-hidden bg-tint z-[2] transition-transform duration-[600ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] shadow-[0_1px_2px_rgba(10,10,10,0.04),0_20px_40px_-16px_rgba(10,10,10,0.22),0_40px_80px_-24px_rgba(10,10,10,0.18)]"
            style="transform: rotate(3.5deg);"
          >
            <picture class="block w-full h-full">
              <source
                type="image/avif"
                srcset={"#{~p"/images/home/lagoon-4x5-360.avif"} 360w, #{~p"/images/home/lagoon-4x5-720.avif"} 720w"}
                sizes="(max-width: 980px) 52vw, 291px"
              />
              <source
                type="image/webp"
                srcset={"#{~p"/images/home/lagoon-4x5-360.webp"} 360w, #{~p"/images/home/lagoon-4x5-720.webp"} 720w"}
                sizes="(max-width: 980px) 52vw, 291px"
              />
              <img
                class="w-full h-full object-cover"
                src={~p"/images/home/lagoon-4x5-720.webp"}
                width="720"
                height="900"
                alt=""
                loading="eager"
                decoding="async"
              />
            </picture>
            <span class="absolute left-2.5 top-2.5 inline-flex items-center gap-1.5 px-2 py-1 bg-brand-accent/[0.92] backdrop-blur-md rounded-[3px] font-brand-mono text-[10.5px] text-ink tracking-[0.01em]">
              golden-fox
            </span>
          </div>
          <div
            class="absolute bottom-0 left-[14%] w-[54%] aspect-[5/4] rounded-[14px] overflow-hidden bg-tint z-[4] transition-transform duration-[600ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] shadow-[0_1px_2px_rgba(10,10,10,0.04),0_20px_40px_-16px_rgba(10,10,10,0.22),0_40px_80px_-24px_rgba(10,10,10,0.18)]"
            style="transform: rotate(-1.5deg);"
          >
            <picture class="block w-full h-full">
              <source
                type="image/avif"
                srcset={"#{~p"/images/home/grill-5x4-400.avif"} 400w, #{~p"/images/home/grill-5x4-800.avif"} 800w"}
                sizes="(max-width: 980px) 54vw, 302px"
              />
              <source
                type="image/webp"
                srcset={"#{~p"/images/home/grill-5x4-400.webp"} 400w, #{~p"/images/home/grill-5x4-800.webp"} 800w"}
                sizes="(max-width: 980px) 54vw, 302px"
              />
              <img
                class="w-full h-full object-cover"
                src={~p"/images/home/grill-5x4-800.webp"}
                width="800"
                height="640"
                alt=""
                loading="eager"
                decoding="async"
              />
            </picture>
            <span class="absolute left-2.5 top-2.5 inline-flex items-center gap-1.5 px-2 py-1 bg-ink/[0.78] backdrop-blur-md rounded-[3px] font-brand-mono text-[10.5px] text-white tracking-[0.01em]">
              quiet-otter
            </span>
          </div>
          <div
            class="absolute bottom-[8%] right-[4%] w-[32%] aspect-square rounded-[14px] overflow-hidden bg-tint z-[1] transition-transform duration-[600ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] shadow-[0_1px_2px_rgba(10,10,10,0.04),0_20px_40px_-16px_rgba(10,10,10,0.22),0_40px_80px_-24px_rgba(10,10,10,0.18)]"
            style="transform: rotate(5.5deg);"
          >
            <picture class="block w-full h-full">
              <source
                type="image/avif"
                srcset={"#{~p"/images/home/mailboxes-square-240.avif"} 240w, #{~p"/images/home/mailboxes-square-480.avif"} 480w"}
                sizes="(max-width: 980px) 32vw, 179px"
              />
              <source
                type="image/webp"
                srcset={"#{~p"/images/home/mailboxes-square-240.webp"} 240w, #{~p"/images/home/mailboxes-square-480.webp"} 480w"}
                sizes="(max-width: 980px) 32vw, 179px"
              />
              <img
                class="w-full h-full object-cover"
                src={~p"/images/home/mailboxes-square-480.webp"}
                width="480"
                height="480"
                alt=""
                loading="eager"
                decoding="async"
              />
            </picture>
            <span class="absolute left-2 top-2 inline-flex items-center gap-1 px-1.5 py-0.5 bg-brand-accent/[0.92] backdrop-blur-md rounded-[3px] font-brand-mono text-[9px] text-ink tracking-[0.01em]">
              golden-fox
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3">
      <div class="mt-[clamp(40px,6vw,80px)] max-md:mt-[36px] py-6 max-md:py-4 border-t border-b border-black/[0.06] flex items-center gap-[clamp(28px,5vw,64px)] max-md:gap-6 flex-wrap font-brand-sans text-[14px] max-md:text-[13px] text-mid tracking-[-0.005em] brand-reveal opacity-0 translate-y-2.5 motion-safe:animate-rise">
        <div class="inline-flex items-baseline gap-1">
          <span class="font-brand-sans font-bold text-[26px] max-md:text-[20px] text-ink tracking-[-0.03em] mr-2.5 max-md:mr-1.5">
            100%
          </span>
          <span>originals · no re-encoding</span>
        </div>
        <div class="inline-flex items-baseline gap-1">
          <span class="font-brand-sans font-bold text-[26px] max-md:text-[20px] text-ink tracking-[-0.03em] mr-2.5 max-md:mr-1.5">
            1 MiB
          </span>
          <span>chunked, resumable uploads</span>
        </div>
        <div class="inline-flex items-baseline gap-1">
          <span class="font-brand-sans font-bold text-[26px] max-md:text-[20px] text-ink tracking-[-0.03em] mr-2.5 max-md:mr-1.5">
            0
          </span>
          <span>accounts to manage</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[clamp(64px,9vw,128px)] max-md:py-[56px]">
    <div class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3">
      <div class="flex items-baseline justify-between gap-6 mb-[clamp(36px,5vw,64px)] max-md:mb-8 max-[760px]:flex-col">
        <h2 class="font-brand-sans font-bold text-[clamp(32px,4.2vw,56px)] max-md:text-[28px] leading-[1.02] tracking-[-0.035em] max-w-[18ch]">
          The trip in four acts.
        </h2>
        <p class="text-[16px] max-md:text-[15px] text-mid max-w-[36ch] leading-[1.5]">
          If you've ever tried to keep a shared photo album on the road, you know all four of these. We did. That's why imaedge exists.
        </p>
      </div>

      <ol class="grid grid-cols-2 gap-x-12 gap-y-12 max-[760px]:grid-cols-1 max-[760px]:gap-y-8 list-none p-0">
        <li class="flex flex-col gap-3">
          <h3 class="font-bold text-[clamp(20px,2vw,26px)] max-md:text-[19px] leading-[1.2] tracking-[-0.025em] text-ink">
            Before a photo is shared, it has to be sent.
          </h3>
          <p class="text-mid text-[15px] max-md:text-[14.5px] leading-[1.55] max-w-[44ch]">
            Every evening starts with AirDrop. Then iMessage when AirDrop refuses. Then a quick mail when iMessage chokes on the HEIC. The photo that one of us already took is the one we now have to send to the other.
          </p>
        </li>

        <li class="flex flex-col gap-3">
          <h3 class="font-bold text-[clamp(20px,2vw,26px)] max-md:text-[19px] leading-[1.2] tracking-[-0.025em] text-ink">
            One of us spends the night uploading.
          </h3>
          <p class="text-mid text-[15px] max-md:text-[14.5px] leading-[1.55] max-w-[44ch]">
            Once everything has been collected on one phone, that person uploads it into a WordPress album, picture by picture. Twelve days in, that's a job. It used to be me, every single time.
          </p>
        </li>

        <li class="flex flex-col gap-3">
          <h3 class="font-bold text-[clamp(20px,2vw,26px)] max-md:text-[19px] leading-[1.2] tracking-[-0.025em] text-ink">
            The hotel WiFi loops through Frankfurt.
          </h3>
          <p class="text-mid text-[15px] max-md:text-[14.5px] leading-[1.55] max-w-[44ch]">
            A 6 MB original from a Mexican beach café takes a minute over the roaming SIM that backhauls to Germany. The screen sleeps, the upload dies, the progress bar lies. Tomorrow morning we start again.
          </p>
        </li>

        <li class="flex flex-col gap-3">
          <h3 class="font-bold text-[clamp(20px,2vw,26px)] max-md:text-[19px] leading-[1.2] tracking-[-0.025em] text-ink">
            A screenshot from this morning lands at the end.
          </h3>
          <p class="text-mid text-[15px] max-md:text-[14.5px] leading-[1.55] max-w-[44ch]">
            Screenshots carry the timestamp of when they were saved, not when the thing happened. So the snapshot of the bus ticket sits a week after the bus ride. Manual reordering, every single time.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section
    id="how"
    class="py-[clamp(72px,10vw,140px)] pb-[clamp(48px,6vw,96px)] max-md:py-[56px] max-md:pb-10"
  >
    <div class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3">
      <div class="flex items-baseline justify-between gap-6 mb-[clamp(36px,5vw,64px)] max-md:mb-8 max-[760px]:flex-col">
        <h2 class="font-brand-sans font-bold text-[clamp(32px,4.2vw,56px)] max-md:text-[28px] leading-[1.02] tracking-[-0.035em] max-w-[18ch]">
          Four small certainties.
        </h2>
        <p class="text-[16px] max-md:text-[15px] text-mid max-w-[32ch] leading-[1.5]">
          A list of accounts, sign-in flows and ZIP exports we deliberately do not have. What is left is the part that matters.
        </p>
      </div>

      <div class="grid grid-cols-6 gap-4 max-[980px]:grid-cols-4 max-[620px]:grid-cols-1">
        <div class="col-span-3 min-h-[320px] bg-white border border-black/[0.06] rounded-[18px] p-7 max-md:p-5 flex flex-col gap-3.5 relative overflow-hidden max-[980px]:col-span-4 max-[620px]:col-span-1 max-[620px]:min-h-0">
          <h3 class="font-bold text-[clamp(28px,3vw,40px)] max-md:text-[22px] leading-[1.05] tracking-[-0.025em] text-ink">
            One URL, many phones.
          </h3>
          <p class="text-mid text-[14.5px] leading-[1.55] max-w-[42ch]">
            Share the link with anyone in earshot. Whoever has it can add, sort, retry, export. No accounts, no admin roles, no permission dance.
          </p>
          <div class="mt-auto pt-4">
            <div class="font-brand-mono text-[14px] max-md:text-[12px] bg-tint rounded-[3px] py-3 px-3.5 inline-block max-w-full overflow-hidden whitespace-nowrap">
              <span class="text-mid">imaedge.app/i/</span><span class="text-ink tracking-[-0.005em]">dOKOhJNWglrvYDpzmIk2DVYbnw8</span>
            </div>
          </div>
        </div>

        <div class="col-span-3 min-h-[320px] bg-white border border-black/[0.06] rounded-[18px] p-7 max-md:p-5 flex flex-col gap-3.5 relative overflow-hidden max-[980px]:col-span-4 max-[620px]:col-span-1 max-[620px]:min-h-0">
          <h3 class="font-bold text-[clamp(28px,3vw,40px)] max-md:text-[22px] leading-[1.05] tracking-[-0.025em] text-ink">
            Resumable on bad WiFi.
          </h3>
          <p class="text-mid text-[14.5px] leading-[1.55] max-w-[42ch]">
            Files queue locally, hash in the browser, upload in 1 MiB chunks and resume after every drop. Close the tab whenever.
          </p>
          <div class="mt-auto pt-4 grid grid-cols-[repeat(16,1fr)] gap-[3px]" aria-hidden="true">
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-ink rounded-[2px] opacity-90"></span>
            <span class="aspect-square bg-brand-accent rounded-[2px] animate-blink"></span>
            <span class="aspect-square bg-tint rounded-[2px]"></span>
            <span class="aspect-square bg-tint rounded-[2px]"></span>
          </div>
        </div>

        <div class="col-span-4 min-h-[220px] bg-white border border-black/[0.06] rounded-[18px] p-7 max-md:p-5 flex flex-col gap-3.5 relative overflow-hidden max-[980px]:col-span-4 max-[620px]:col-span-1 max-[620px]:min-h-0">
          <h3 class="font-bold text-[24px] max-md:text-[20px] leading-[1.15] tracking-[-0.025em] text-ink">
            Original bytes, untouched.
          </h3>
          <p class="text-mid text-[14.5px] leading-[1.55] max-w-[42ch]">
            No re-encoding, no EXIF stripping, no surprise compression. The byte stream from your phone is the byte stream in storage.
          </p>
          <div class="mt-auto pt-4">
            <div class="flex items-center justify-between gap-3 py-2.5 px-3.5 bg-tint rounded-[3px] font-brand-mono text-[12.5px] max-md:text-[11px] text-ink-2 flex-wrap">
              <span>IMG_2418.HEIC</span>
              <span class="text-mid">sha256 · 4f7a…0bd9</span>
              <span class="text-brand-accent-d font-medium">✓ stored intact</span>
            </div>
          </div>
        </div>

        <div class="col-span-2 min-h-[220px] bg-white border border-black/[0.06] rounded-[18px] p-7 max-md:p-5 flex flex-col gap-3.5 relative overflow-hidden max-[980px]:col-span-4 max-[620px]:col-span-1 max-[620px]:min-h-0">
          <h3 class="font-bold text-[24px] max-md:text-[20px] leading-[1.15] tracking-[-0.025em] text-ink">
            Names, not names.
          </h3>
          <p class="text-mid text-[14.5px] leading-[1.55] max-w-[42ch]">
            Every device gets a quiet animal handle.
          </p>
          <div class="mt-auto pt-4 flex flex-wrap gap-1.5" aria-hidden="true">
            <span class="py-1 px-2.5 bg-ink text-paper rounded-[3px] font-brand-mono text-[11.5px]">
              quiet-otter
            </span>
            <span class="py-1 px-2.5 bg-tint text-ink-2 rounded-[3px] font-brand-mono text-[11.5px]">
              golden-fox
            </span>
            <span class="py-1 px-2.5 bg-tint text-ink-2 rounded-[3px] font-brand-mono text-[11.5px]">
              steady-heron
            </span>
            <span class="py-1 px-2.5 bg-tint text-ink-2 rounded-[3px] font-brand-mono text-[11.5px]">
              slow-badger
            </span>
            <span class="py-1 px-2.5 bg-tint text-ink-2 rounded-[3px] font-brand-mono text-[11.5px]">
              warm-turtle
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="brand-faq py-[clamp(48px,6vw,96px)] max-md:py-12">
    <div class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3">
      <h2 class="font-bold text-[clamp(32px,4.2vw,52px)] max-md:text-[28px] tracking-[-0.035em] leading-[1.02] mb-8 max-w-[18ch]">
        Quiet questions.
      </h2>

      <details class="border-t border-black/[0.06] py-5 max-md:py-4">
        <summary class="cursor-pointer flex justify-between items-baseline gap-4 font-medium text-[clamp(18px,1.8vw,22px)] max-md:text-[16px] tracking-[-0.02em]">
          Who can see a collection?
        </summary>
        <p class="mt-3.5 text-mid max-w-[60ch] leading-[1.6] text-[15.5px] max-md:text-[14.5px]">
          Anyone with the link. There are no accounts and no admin roles. The link is the only key. Collection pages are <code class="font-brand-mono text-[13px]">noindex</code>, never linked from anywhere, and never appear in any list.
        </p>
      </details>
      <details class="border-t border-black/[0.06] py-5 max-md:py-4">
        <summary class="cursor-pointer flex justify-between items-baseline gap-4 font-medium text-[clamp(18px,1.8vw,22px)] max-md:text-[16px] tracking-[-0.02em]">
          What happens to my original files?
        </summary>
        <p class="mt-3.5 text-mid max-w-[60ch] leading-[1.6] text-[15.5px] max-md:text-[14.5px]">
          They are stored unchanged. No re-encoding, no EXIF rewrite, no compression. We hash the file in the browser before upload, and again on the server after assembly. If the hashes disagree, nothing is finalised.
        </p>
      </details>
      <details class="border-t border-black/[0.06] py-5 max-md:py-4">
        <summary class="cursor-pointer flex justify-between items-baseline gap-4 font-medium text-[clamp(18px,1.8vw,22px)] max-md:text-[16px] tracking-[-0.02em]">
          What if I lose signal mid-upload?
        </summary>
        <p class="mt-3.5 text-mid max-w-[60ch] leading-[1.6] text-[15.5px] max-md:text-[14.5px]">
          Files are queued in your browser first. Each is chunked and uploaded as 1 MiB pieces. After a drop, the client asks the server which chunks already landed and resumes only the missing ones. Close the tab and it picks up where you left off.
        </p>
      </details>
      <details class="border-t border-b border-black/[0.06] py-5 max-md:py-4">
        <summary class="cursor-pointer flex justify-between items-baseline gap-4 font-medium text-[clamp(18px,1.8vw,22px)] max-md:text-[16px] tracking-[-0.02em]">
          How do I get the photos out?
        </summary>
        <p class="mt-3.5 text-mid max-w-[60ch] leading-[1.6] text-[15.5px] max-md:text-[14.5px]">
          Every collection has an <code class="font-brand-mono text-[13px]">/export</code>
          page, a plain HTML index that lists every image in current order with a direct link to each original. Same permission as the main link. No separate token, no ZIP.
        </p>
      </details>
    </div>
  </section>

  <section class="max-w-[1320px] mx-auto px-8 max-md:px-4 max-[460px]:px-3">
    <div class="my-[clamp(48px,6vw,80px)] max-md:my-10 py-[clamp(48px,7vw,96px)] max-md:py-10 px-[clamp(28px,5vw,64px)] max-md:px-6 bg-ink text-paper rounded-[24px] grid grid-cols-[1fr_auto] gap-8 items-center relative overflow-hidden max-[760px]:grid-cols-1 before:content-[''] before:absolute before:right-[-10%] before:top-[-50%] before:w-[60%] before:aspect-square before:[background:radial-gradient(circle,rgba(34,211,238,0.18),transparent_60%)] before:pointer-events-none">
      <h2 class="font-bold text-[clamp(32px,5vw,64px)] max-md:text-[28px] leading-none tracking-[-0.04em] max-w-[18ch] relative">
        One link. The <em class="not-italic text-brand-accent">originals</em>. Nothing else.
      </h2>
      <form action={~p"/collections"} method="post" class="relative">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button
          type="submit"
          class="group inline-flex items-center gap-2.5 px-7 py-[18px] max-md:px-5 max-md:py-4 bg-paper text-ink rounded-[4px] font-medium text-[16px] max-md:text-[15px] transition-colors hover:bg-white cursor-pointer"
        >
          <span>Start a collection</span>
          <svg
            class="w-[18px] h-[18px] stroke-current stroke-[1.8] fill-none transition-transform group-hover:translate-x-[3px]"
            viewBox="0 0 24 24"
          >
            <path
              d="M5 12h14M13 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </form>
    </div>
  </section>
</Layouts.marketing_shell>
