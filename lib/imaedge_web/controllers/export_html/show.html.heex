<Layouts.workspace flash={@flash} live?={false} show_new_collection={false}>
  <section class="max-w-[1320px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 py-[clamp(56px,7vw,96px)] pb-[clamp(40px,5vw,64px)] max-md:py-[32px] max-md:pb-[28px] max-[460px]:py-[28px]">
    <div class="flex flex-wrap items-baseline gap-x-5 max-md:gap-x-3 gap-y-0.5 font-brand-sans text-[13px] max-md:text-[11px] text-mid mb-4 max-md:mb-2 tracking-[-0.005em]">
      <span title={format_absolute(@opened_at)}>opened {format_relative(@opened_at)}</span>
      <span title={format_absolute(@last_activity_at)}>
        edited {format_relative(@last_activity_at)}
      </span>
    </div>

    <h1 class="font-brand-sans font-bold text-[clamp(32px,5.8vw,68px)] max-md:text-[24px] max-[460px]:text-[21px] leading-none tracking-[-0.035em] max-md:tracking-[-0.02em] text-ink break-words [overflow-wrap:anywhere] brand-reveal opacity-0 translate-y-2 motion-safe:animate-rise">
      {Collection.display_name(@collection)}
    </h1>

    <p
      :if={Collection.named?(@collection)}
      class="mt-3 max-md:mt-1.5 font-brand-mono text-[14px] max-md:text-[11px] text-mid break-all [overflow-wrap:anywhere] brand-reveal opacity-0 translate-y-2 motion-safe:animate-rise"
    >
      imaedge.app/i/{@collection.public_id}
    </p>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-6 mt-9 max-md:gap-x-2 max-md:gap-y-[18px] max-md:mt-6 brand-reveal opacity-0 translate-y-2 motion-safe:animate-rise">
      <a
        class="inline-flex items-center gap-2.5 px-3.5 py-2.5 bg-white border border-ink rounded-[3px] font-medium text-[13.5px] max-md:text-[13px] text-ink transition-colors hover:bg-ink hover:text-paper"
        href={~p"/i/#{@collection.public_id}"}
      >
        <svg
          class="w-3.5 h-3.5 stroke-current stroke-[1.8] fill-none"
          viewBox="0 0 24 24"
        >
          <path
            d="M15 18l-6-6 6-6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>back to workspace</span>
      </a>

      <a
        class="inline-flex items-center gap-2.5 px-3.5 py-2.5 bg-ink text-paper border border-ink rounded-[3px] font-medium text-[13.5px] max-md:text-[13px] transition-colors hover:bg-[#1a1a1a]"
        href="javascript:window.print()"
      >
        <svg
          class="w-3.5 h-3.5 stroke-current stroke-[1.8] fill-none"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M6 14h12v7H6z"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>print / save PDF</span>
      </a>

      <div class="ml-auto max-[760px]:ml-0 max-[760px]:w-full max-[760px]:flex-wrap max-[760px]:gap-[18px] max-[760px]:pt-2.5 inline-flex gap-7 font-brand-sans text-[13.5px] text-mid tracking-[-0.005em]">
        <div class="inline-flex items-baseline gap-1.5">
          <span class="font-brand-sans font-bold text-[22px] max-md:text-[18px] text-ink tracking-[-0.03em] mr-2 max-md:mr-1">
            {length(@images)}
          </span>
          <span>images</span>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-[1320px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-[clamp(40px,5vw,64px)]">
    <div class="flex items-center gap-4 py-3.5 border-t border-b border-black/[0.06] font-brand-sans text-[14px] text-mid mb-8 brand-reveal opacity-0 translate-y-2 motion-safe:animate-rise">
      <span>Tap an image to download the unmodified full-resolution source.</span>
    </div>

    <ol class="flex flex-col divide-y divide-black/[0.06] border-t border-b border-black/[0.06] brand-reveal opacity-0 translate-y-2 motion-safe:animate-rise">
      <li
        :for={{image, index} <- Enum.with_index(@images, 1)}
        class="grid grid-cols-[88px_minmax(0,1fr)] max-[620px]:grid-cols-[64px_minmax(0,1fr)] gap-4 max-md:gap-3 items-center py-4 max-md:py-3"
      >
        <a
          href={image.original_url}
          download={download_name(image, index)}
          class="block w-[88px] h-[88px] max-[620px]:w-16 max-[620px]:h-16 overflow-hidden rounded-[2px] bg-tint border border-black/[0.06] transition-opacity hover:opacity-90"
          title="Download original"
        >
          <img
            src={image.preview_small_url || image.original_url}
            loading="lazy"
            alt={"Image #{index}"}
            class="w-full h-full object-cover"
          />
        </a>

        <div class="min-w-0">
          <div class="flex items-baseline gap-2.5 font-brand-mono text-[12px] text-mid tracking-[0.01em]">
            <span class="text-ink font-medium">
              {String.pad_leading(to_string(index), 4, "0")}
            </span>
            <span>{Calendar.strftime(image.effective_taken_at, "%Y-%m-%d · %H:%M:%S")}</span>
          </div>
          <div class="mt-1 font-brand-mono text-[11.5px] text-mid">
            {image.contributor_id}
          </div>
        </div>
      </li>
    </ol>

    <p
      :if={@images == []}
      class="mt-6 py-6 px-4 bg-tint rounded-[3px] font-brand-sans text-[14px] text-mid"
    >
      No images in this collection yet.
    </p>
  </section>
</Layouts.workspace>
