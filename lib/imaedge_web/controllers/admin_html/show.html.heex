<Layouts.workspace flash={@flash} live?={false} show_new_collection={false}>
  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 py-[clamp(42px,5vw,72px)] max-md:py-8">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-black/[0.08] pb-5">
      <div>
        <p class="font-brand-mono text-[11px] uppercase tracking-[0.12em] text-mid">
          Private admin
        </p>
        <h1 class="mt-2 font-brand-sans font-bold text-[clamp(30px,4.8vw,56px)] leading-none text-ink">
          Usage and health
        </h1>
        <p class="mt-3 max-w-3xl font-brand-sans text-[14px] leading-6 text-mid">
          DB-only statistics. Days are grouped in {@usage.timezone}. Storage counts accepted original bytes from image rows, previews are not estimated.
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-2" aria-label="days filter">
        <.link class={filter_link_class(@usage.days, 30)} href={~p"/admin?days=30"}>30</.link>
        <.link class={filter_link_class(@usage.days, 90)} href={~p"/admin?days=90"}>90</.link>
        <.link class={filter_link_class(@usage.days, 365)} href={~p"/admin?days=365"}>365</.link>
        <.link class={filter_link_class(@usage.days, :all)} href={~p"/admin?days=all"}>all</.link>
      </nav>
    </div>

    <div class="mt-6 grid grid-cols-4 gap-px overflow-hidden border border-black/[0.08] bg-black/[0.08] max-lg:grid-cols-2 max-[620px]:grid-cols-1">
      <div class="bg-white p-4">
        <p class="font-brand-mono text-[11px] uppercase tracking-[0.1em] text-mid">storage</p>
        <p class="mt-2 font-brand-sans text-[28px] font-bold leading-none text-ink">
          {format_bytes(@usage.summary.accepted_storage_bytes)}
        </p>
        <p class="mt-2 font-brand-sans text-[12px] text-mid">accepted original bytes</p>
      </div>
      <div class="bg-white p-4">
        <p class="font-brand-mono text-[11px] uppercase tracking-[0.1em] text-mid">collections</p>
        <p class="mt-2 font-brand-sans text-[28px] font-bold leading-none text-ink">
          {@usage.summary.collections}
        </p>
        <p class="mt-2 font-brand-sans text-[12px] text-mid">secret-link workspaces</p>
      </div>
      <div class="bg-white p-4">
        <p class="font-brand-mono text-[11px] uppercase tracking-[0.1em] text-mid">images</p>
        <p class="mt-2 font-brand-sans text-[28px] font-bold leading-none text-ink">
          {@usage.summary.accepted_images}
        </p>
        <p class="mt-2 font-brand-sans text-[12px] text-mid">
          {@usage.summary.complete_images} complete, {@usage.summary.processing_images} processing
        </p>
      </div>
      <div class="bg-white p-4">
        <p class="font-brand-mono text-[11px] uppercase tracking-[0.1em] text-mid">uploads</p>
        <p class="mt-2 font-brand-sans text-[28px] font-bold leading-none text-ink">
          {@usage.summary.upload_sessions}
        </p>
        <p class="mt-2 font-brand-sans text-[12px] text-mid">
          {@usage.summary.failed_uploads} failed, {format_bytes(
            @usage.summary.active_upload_bytes
          )} active bytes
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-12">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="font-brand-sans text-[22px] font-bold leading-none text-ink">
          Daily activity
        </h2>
        <p class="mt-1 font-brand-sans text-[12px] text-mid">
          {days_label(@usage.days)}. Completed images use current complete rows grouped by their latest image update.
        </p>
      </div>
    </div>

    <div class="overflow-x-auto border-y border-black/[0.08]">
      <table class="min-w-[980px] w-full border-collapse font-brand-sans text-[13px] whitespace-nowrap">
        <thead>
          <tr class="border-b border-black/[0.08] text-left font-brand-mono text-[11px] uppercase tracking-[0.08em] text-mid">
            <th class="py-2.5 pr-4 font-medium">day</th>
            <th class="py-2.5 px-4 font-medium text-right">active collections</th>
            <th class="py-2.5 px-4 font-medium text-right">new collections</th>
            <th class="py-2.5 px-4 font-medium text-right">uploads started</th>
            <th class="py-2.5 px-4 font-medium text-right">uploads finalized</th>
            <th class="py-2.5 px-4 font-medium text-right">images accepted</th>
            <th class="py-2.5 px-4 font-medium text-right">images completed</th>
            <th class="py-2.5 px-4 font-medium text-right">deleted</th>
            <th class="py-2.5 pl-4 font-medium text-right">accepted bytes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/[0.06]">
          <tr :for={day <- @usage.daily_activity}>
            <td class="py-2.5 pr-4 font-brand-mono text-[12px] text-ink">
              {format_date(day.date)}
            </td>
            <td class="py-2.5 px-4 text-right">{day.active_collections}</td>
            <td class="py-2.5 px-4 text-right">{day.new_collections}</td>
            <td class="py-2.5 px-4 text-right">{day.uploads_started}</td>
            <td class="py-2.5 px-4 text-right">{day.uploads_finalized}</td>
            <td class="py-2.5 px-4 text-right">{day.images_accepted}</td>
            <td class="py-2.5 px-4 text-right">{day.images_completed}</td>
            <td class="py-2.5 px-4 text-right">{day.images_deleted}</td>
            <td class="py-2.5 pl-4 text-right font-brand-mono text-[12px]">
              {format_bytes(day.accepted_bytes)}
            </td>
          </tr>
          <tr :if={@usage.daily_activity == []}>
            <td colspan="9" class="py-5 text-mid">No activity in this range.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-12">
    <div class="grid grid-cols-2 gap-8 max-lg:grid-cols-1">
      <div>
        <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
          Storage by type
        </h2>
        <.status_table
          rows={@usage.storage_by_mime}
          label_key={:mime}
          value_label="images"
          byte_label="bytes"
        />
      </div>

      <div>
        <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
          Upload status
        </h2>
        <.status_table
          rows={@usage.upload_statuses}
          label_key={:status}
          value_label="sessions"
          byte_label="bytes"
        />
      </div>
    </div>
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-12">
    <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
      Top storage collections
    </h2>
    <.collection_table rows={@usage.top_storage_collections} />
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-12">
    <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
      Recent collection activity
    </h2>
    <.collection_table rows={@usage.recent_collections} />
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-12">
    <div class="grid grid-cols-2 gap-8 max-xl:grid-cols-1">
      <div>
        <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
          Collections needing attention
        </h2>
        <.collection_table rows={@usage.failed_collections} compact?={true} />
      </div>

      <div>
        <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
          Oban health
        </h2>
        <div class="border-y border-black/[0.08]">
          <table class="w-full border-collapse font-brand-sans text-[13px] whitespace-nowrap">
            <thead>
              <tr class="border-b border-black/[0.08] text-left font-brand-mono text-[11px] uppercase tracking-[0.08em] text-mid">
                <th class="py-2.5 pr-4 font-medium">state</th>
                <th class="py-2.5 pl-4 text-right font-medium">jobs</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-black/[0.06]">
              <tr :for={row <- @usage.oban_states}>
                <td class="py-2.5 pr-4">{row.state}</td>
                <td class="py-2.5 pl-4 text-right">{row.count}</td>
              </tr>
              <tr :if={@usage.oban_states == []}>
                <td colspan="2" class="py-5 text-mid">No Oban jobs recorded.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-6 border-y border-black/[0.08]">
          <table class="w-full border-collapse font-brand-sans text-[13px] whitespace-nowrap">
            <thead>
              <tr class="border-b border-black/[0.08] text-left font-brand-mono text-[11px] uppercase tracking-[0.08em] text-mid">
                <th class="py-2.5 pr-4 font-medium">problem job</th>
                <th class="py-2.5 px-4 text-right font-medium">attempt</th>
                <th class="py-2.5 pl-4 text-right font-medium">time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-black/[0.06]">
              <tr :for={job <- @usage.oban_problem_jobs}>
                <td class="py-2.5 pr-4">
                  <span class="font-medium text-ink">{job.state}</span>
                  <span class="text-mid">{job.worker}</span>
                </td>
                <td class="py-2.5 px-4 text-right">{job.attempt}/{job.max_attempts}</td>
                <td class="py-2.5 pl-4 text-right font-brand-mono text-[12px]">
                  {format_datetime(job.attempted_at || job.scheduled_at)}
                </td>
              </tr>
              <tr :if={@usage.oban_problem_jobs == []}>
                <td colspan="3" class="py-5 text-mid">
                  No retryable, cancelled, or discarded jobs.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-[1480px] mx-auto px-8 max-md:px-3 max-[460px]:px-2.5 pb-16">
    <h2 class="mb-3 font-brand-sans text-[22px] font-bold leading-none text-ink">
      Recent failed uploads
    </h2>
    <div class="overflow-x-auto border-y border-black/[0.08]">
      <table class="min-w-[760px] w-full border-collapse font-brand-sans text-[13px] whitespace-nowrap">
        <thead>
          <tr class="border-b border-black/[0.08] text-left font-brand-mono text-[11px] uppercase tracking-[0.08em] text-mid">
            <th class="py-2.5 pr-4 font-medium">collection</th>
            <th class="py-2.5 px-4 text-right font-medium">bytes</th>
            <th class="py-2.5 px-4 text-right font-medium">updated</th>
            <th class="py-2.5 pl-4 font-medium">error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/[0.06]">
          <tr :for={upload <- @usage.failed_uploads}>
            <td class="py-2.5 pr-4">
              <.link
                class="font-medium text-ink underline decoration-black/20 underline-offset-2 hover:decoration-black"
                href={~p"/i/#{upload.collection_public_id}"}
              >
                {upload.collection_name || upload.collection_public_id}
              </.link>
            </td>
            <td class="py-2.5 px-4 text-right font-brand-mono text-[12px]">
              {format_bytes(upload.byte_size)}
            </td>
            <td class="py-2.5 px-4 text-right font-brand-mono text-[12px]">
              {format_datetime(upload.updated_at)}
            </td>
            <td class="py-2.5 pl-4 text-mid">{truncate_text(upload.error_message)}</td>
          </tr>
          <tr :if={@usage.failed_uploads == []}>
            <td colspan="4" class="py-5 text-mid">No failed uploads.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layouts.workspace>
